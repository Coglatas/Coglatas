+    [Fact]
+    public async Task Query_boolean_preserves_requiredness_and_advertises_true_false_wire_strings()
+    {
+        var schema = new OpenApiSchema { Type = JsonSchemaType.Boolean };
+        var parameter = new OpenApiParameter
+        {
+            Name = "Archived",
+            In = ParameterLocation.Query,
+            Required = true,
+            Schema = schema
+        };
+        var operation = new OpenApiOperation { Parameters = [parameter] };
+
+        await new SecurityOpenApiOperationTransformer().TransformAsync(
+            operation, CreateContext(), CancellationToken.None);
+
+        Assert.Equal(JsonSchemaType.Boolean | JsonSchemaType.String, schema.Type);
+        Assert.Equal("^(?:[tT][rR][uU][eE]|[fF][aA][lL][sS][eE])$", schema.Pattern);
+        Assert.True(parameter.Required);
+        Assert.Equal("Archived", parameter.Name);
+        Assert.Equal(ParameterLocation.Query, parameter.In);
+    }
+
+    [Fact]
+    public async Task Boolean_wire_metadata_preserves_body_headers_paths_and_other_query_types()
+    {
+        var header = new OpenApiSchema { Type = JsonSchemaType.Boolean };
+        var path = new OpenApiSchema { Type = JsonSchemaType.Boolean };
+        var number = new OpenApiSchema { Type = JsonSchemaType.Integer, Format = "int32" };
+        var body = new OpenApiSchema { Type = JsonSchemaType.Boolean };
+        var operation = new OpenApiOperation
+        {
+            Parameters =
+            [
+                new OpenApiParameter { Name = "Header", In = ParameterLocation.Header, Schema = header },
+                new OpenApiParameter { Name = "Path", In = ParameterLocation.Path, Schema = path },
+                new OpenApiParameter { Name = "Page", In = ParameterLocation.Query, Schema = number }
+            ],
+            RequestBody = new OpenApiRequestBody
+            {
+                Content = new Dictionary<string, OpenApiMediaType>
+                {
+                    ["application/json"] = new OpenApiMediaType { Schema = body }
+                }
+            }
+        };
+
+        await new SecurityOpenApiOperationTransformer().TransformAsync(
+            operation, CreateContext(), CancellationToken.None);
+
+        Assert.Equal(JsonSchemaType.Boolean, header.Type);
+        Assert.Equal(JsonSchemaType.Boolean, path.Type);
+        Assert.Equal(JsonSchemaType.Boolean, body.Type);
+        Assert.Null(header.Pattern);
+        Assert.Null(path.Pattern);
+        Assert.Null(body.Pattern);
+        Assert.Equal(JsonSchemaType.Integer, number.Type);
+        Assert.Equal("int32", number.Format);
+        Assert.Null(number.Pattern);
+    }
