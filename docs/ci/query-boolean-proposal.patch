+    private static void ConfigureQueryBooleanWireSchemas(OpenApiOperation operation)
+    {
+        foreach (var parameter in operation.Parameters ?? [])
+        {
+            if (parameter.In != ParameterLocation.Query ||
+                parameter.Schema is not OpenApiSchema schema ||
+                schema.Type != JsonSchemaType.Boolean)
+            {
+                continue;
+            }
+
+            // Query scalars travel as text. Preserve native boolean generation
+            // while describing only the existing true/false wire spellings.
+            schema.Type = JsonSchemaType.Boolean | JsonSchemaType.String;
+            schema.Pattern = "^(?:[tT][rR][uU][eE]|[fF][aA][lL][sS][eE])$";
         }
     }
 
