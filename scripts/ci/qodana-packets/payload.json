  "helper": "#!/usr/bin/env python3\n\"\"\"Apply only the exact, source-hash-pinned edits in execution-plan.json.\n\nDefault mode prints a diff and changes nothing. No network, commit, push, rebase,\nmerge, baseline adjustment, or fallback patching is performed.\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport difflib\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\nclass Stop(RuntimeError):\n    \"\"\"A precondition failed; preserve the repository and stop this packet.\"\"\"\n\ndef git_blob_sha(data: bytes) -> str:\n    return hashlib.sha1(b'blob ' + str(len(data)).encode('ascii') + b'\\0' + data).hexdigest()\n\ndef safe_path(root: Path, relative: str) -> Path:\n    candidate = Path(relative)\n    if candidate.is_absolute() or '..' in candidate.parts:\n        raise Stop(f'Unsafe path: {relative}')\n    p = root / candidate\n    current = root\n    for part in candidate.parts:\n        current /= part\n        if current.is_symlink():\n            raise Stop(f'Symlink is not permitted: {relative}')\n    if not p.resolve().is_relative_to(root.resolve()):\n        raise Stop(f'Path escapes repository: {relative}')\n    return p\n\ndef only(text: str, needle: str, label: str) -> int:\n    count = text.count(needle)\n    if count != 1:\n        raise Stop(f'{label}: expected one exact anchor, found {count}: {needle[:90]!r}')\n    return text.index(needle)\n\ndef transform(text: str, operations: list[dict]) -> str:\n    # Work on logical newlines. Byte-level BOM/newline identity is restored later.\n    for op in operations:\n        kind = op['kind']\n        if kind == 'replace':\n            count = text.count(op['old'])\n            if count != op['count']:\n                raise Stop(f'Replacement count mismatch: expected {op[\"count\"]}, found {count}: {op[\"old\"]!r}')\n            text = text.replace(op['old'], op['new'])\n        elif kind == 'rename_identifiers':\n            start = only(text, op['start'], 'Rename start')\n            end = only(text, op['end'], 'Rename end') if op.get('end') else len(text)\n            if end <= start:\n                raise Stop('Reversed rename scope')\n            segment = text[start:end]\n            # All mappings target complete, audited private-field class scopes.\n            # Counts also reject accidental extra uses/comments/string literals.\n            for before, after in op['mapping'].items():\n                if re.search(r'\\b' + re.escape(after) + r'\\b', segment):\n                    raise Stop(f'Rename target already exists: {after}')\n                pattern = r'\\b' + re.escape(before) + r'\\b'\n                segment, count = re.subn(pattern, after, segment)\n                if count != op['counts'][before]:\n                    raise Stop(f'Identifier count mismatch for {before}: {count}')\n            text = text[:start] + segment + text[end:]\n        elif kind == 'unwrap_using':\n            start = only(text, op['start'], 'Using start')\n            end = only(text, op['end'], 'Using end')\n            body_start = start + len(op['start'])\n            if end <= body_start:\n                raise Stop('Invalid using scope')\n            body = text[body_start:end]\n            indent = ' ' * op['dedent']\n            lines = body.splitlines(keepends=True)\n            if any(line.strip() and not line.startswith(indent) for line in lines):\n                raise Stop('Unexpected indentation inside approved using scope')\n            dedented = ''.join(line[len(indent):] if line.strip() else line for line in lines)\n            # Remove ONLY the using block's closing brace, not try's closing brace.\n            end_without_using_brace = op['end'].split('\\n', 1)[1]\n            text = text[:start] + op['replacement'] + dedented + end_without_using_brace + text[end + len(op['end']):]\n        else:\n            raise Stop(f'Unsupported operation: {kind}')\n    return text\n\ndef transform_bytes(data: bytes, operations: list[dict]) -> bytes:\n    bom = b'\\xef\\xbb\\xbf' if data.startswith(b'\\xef\\xbb\\xbf') else b''\n    body = data[len(bom):]\n    if b'\\r' in body.replace(b'\\r\\n', b''):\n        raise Stop('Standalone CR line endings are unsupported')\n    crlf = b'\\r\\n' in body\n    if crlf and b'\\n' in body.replace(b'\\r\\n', b''):\n        raise Stop('Mixed line endings: stop instead of normalizing')\n    text = body.decode('utf-8').replace('\\r\\n', '\\n')\n    after = transform(text, operations)\n    if crlf:\n        after = after.replace('\\n', '\\r\\n')\n    return bom + after.encode('utf-8')\n\ndef command(root: Path, *args: str) -> str:\n    result = subprocess.run(['git', '-C', str(root), *args], text=True, capture_output=True)\n    if result.returncode:\n        raise Stop(f'git {args[0]} failed: {result.stderr.strip()}')\n    return result.stdout\n\ndef prepare(root: Path, packet: dict, plan_sha: str) -> list[tuple[Path, bytes, bytes]]:\n    changes = []\n    for f in packet['files']:\n        p = safe_path(root, f['path'])\n        if not p.is_file():\n            raise Stop(f'Missing approved source file: {f[\"path\"]}')\n        before = p.read_bytes()\n        if git_blob_sha(before) != f['git_blob_sha']:\n            raise Stop(f'Source drift: {f[\"path\"]}. Do not adapt or recreate the edit; return to audit owner.')\n        # Confirm committed source as well as worktree bytes.\n        committed_sha = command(root, 'rev-parse', f'HEAD:{f[\"path\"]}').strip()\n        if committed_sha != f['git_blob_sha']:\n            raise Stop(f'Committed source drift: {f[\"path\"]}')\n        after = transform_bytes(before, f['operations'])\n        if after == before:\n            raise Stop(f'No-op edit in {f[\"path\"]}')\n        changes.append((p, before, after))\n    return changes\n\ndef write_changes(changes: list[tuple[Path, bytes, bytes]]) -> None:\n    # All preconditions and transforms succeeded before any write. Roll back\n    # our own writes on error, but never overwrite concurrent external edits.\n    applied = []\n    try:\n        for path, before, after in changes:\n            if path.read_bytes() != before:\n                raise Stop(f'Concurrent source edit: {path}')\n            mode = path.stat().st_mode\n            fd, tmp = tempfile.mkstemp(prefix='.' + path.name + '.qodana-', dir=path.parent)\n            try:\n                with os.fdopen(fd, 'wb') as out:\n                    out.write(after)\n                    out.flush()\n                    os.fsync(out.fileno())\n                os.chmod(tmp, mode)\n                os.replace(tmp, path)\n            finally:\n                if os.path.exists(tmp): os.unlink(tmp)\n            applied.append((path, before, after))\n    except Exception:\n        for path, before, after in reversed(applied):\n            if path.read_bytes() == after:\n                path.write_bytes(before)\n        raise\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--repo', type=Path, required=True)\n    parser.add_argument('--plan', type=Path, default=Path(__file__).with_name('execution-plan.json'))\n    parser.add_argument('--packet', required=True)\n    parser.add_argument('--apply', action='store_true', help='write only after every precondition passes')\n    parser.add_argument('--check', action='store_true', help='explicit dry-run; this is the default')\n    args = parser.parse_args()\n    if args.apply and args.check:\n        raise Stop('Choose either --check or --apply')\n    root = args.repo.resolve()\n    plan = json.loads(args.plan.read_text(encoding='utf-8'))\n    matches = [p for p in plan['packets'] if p['id'] == args.packet]\n    if len(matches) != 1: raise Stop('Unknown or duplicate packet ID')\n    if command(root, 'rev-parse', '--show-toplevel').strip() != str(root):\n        raise Stop('--repo must be the repository root')\n    if command(root, 'status', '--porcelain').strip():\n        raise Stop('Working tree must be clean. Do not stash/reset unrelated work; use a separate worktree.')\n    # The audited revision must be available and remain an ancestor.\n    command(root, 'merge-base', '--is-ancestor', plan['audit_source_sha'], 'HEAD')\n    changes = prepare(root, matches[0], plan['audit_source_sha'])\n    for p, before, after in changes:\n        print(''.join(difflib.unified_diff(before.decode('utf-8-sig').splitlines(True),after.decode('utf-8-sig').splitlines(True),fromfile='a/'+str(p.relative_to(root)),tofile='b/'+str(p.relative_to(root)))),end='')\n    if args.apply:\n        write_changes(changes)\n        print(f'\\nApplied {args.packet}; no tests, commits, baseline changes or merges performed.')\n    else:\n        print(f'\\nCHECK PASSED: {args.packet}; no files changed.')\n    return 0\n\nif __name__ == '__main__':\n    try:\n        raise SystemExit(main())\n    except (Stop, OSError, UnicodeError, ValueError, KeyError) as error:\n        print(f'STOP: {error}', file=sys.stderr)\n        raise SystemExit(2)\n"
}
